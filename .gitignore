# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
env/
venv/
ENV/

# Jupyter Notebook
.ipynb_checkpoints

# IDE specific files
.idea/
.vscode/

# Ignore data directory with converted NPY files
/data/

# Ignore weights directory with trained models
/weights/
/predictions/

# Debug directories and files - exclude outputs but track scripts
/tools/debug/test_multi_gpu_weights/
/tools/debug/outputs/
/tools/debug/logs/
/tools/debug/*.log
/tools/debug/temp_*
debug_train_output.txt

# But ensure debug scripts themselves are tracked (not ignored)
!/tools/
!/tools/debug/
!/tools/debug/*.py
!/tools/debug/README.md

# Lightning logs
/lightning_logs/

# OS specific files
.DS_Store
Thumbs.db
*.swp
*.swo

# Project specific ignores
/documents/
/tools/visualization_outputs/
*.pdf

# Model files and datasets that might be large
*.h5
*.hdf5
*.pkl
*.npy