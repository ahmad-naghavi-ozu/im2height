# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
env/
venv/
ENV/

# Jupyter Notebook
.ipynb_checkpoints

# IDE specific files
.idea/
.vscode/

# Ignore data directory with converted NPY files
/data/

# Ignore weights directory with trained models
/weights/
/predictions/

# Tools directory - track organized structure, exclude outputs
# All Python scripts, documentation, and reports are tracked
# Only exclude output directories, logs, and temporary files

/tools/debug/outputs/
/tools/debug/logs/
/tools/debug/*.log
/tools/debug/temp_*
/tools/testing/outputs/
/tools/testing/*.log
/tools/testing/temp_*
debug_train_output.txt

# Visualization directory - track code but exclude large output files
/visualization/outputs/

# Lightning logs
/lightning_logs/

# OS specific files
.DS_Store
Thumbs.db
*.swp
*.swo

# Project specific ignores
/documents/
/tools/visualization_outputs/
*.pdf

# Model files and datasets that might be large
*.h5
*.hdf5
*.pkl
*.npy